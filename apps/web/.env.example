# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser — never put secrets in them.

# NestJS API base URL as seen from the Next.js server (the browser never calls the API directly).
API_URL=http://localhost:4000/api/v1

# Public URL of this website (canonical links, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In: OAuth 2.0 *Client ID* (public by design; no client secret is used).
# Leave empty to hide the Google button. Setup steps: README.md → "Google Sign-In".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
