# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Supabase → Project Settings → Database → Connection string → "Session pooler".
# The session pooler works over IPv4 (the direct connection is IPv6-only) and supports migrations.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Origin of the Next.js app, allowed by CORS. Comma-separate several origins.
CORS_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug
