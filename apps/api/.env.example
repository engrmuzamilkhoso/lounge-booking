# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Supabase → Connect → "Session pooler" connection string.
# The session pooler works over IPv4 (the direct connection is IPv6-only) and supports migrations.
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Origin(s) of the Next.js app allowed by CORS, comma-separated.
CORS_ORIGINS=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# Public URL of the website, used in email links (password reset).
WEB_URL=http://localhost:3000

# Signs access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP. Leave SMTP_HOST empty in development to print emails to the log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Majestic Lounge <no-reply@majestic.com.pk>"

# Staff who receive booking, inquiry and registration notifications (comma-separated).
STAFF_NOTIFICATION_EMAILS=
