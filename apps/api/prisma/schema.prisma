// Majestic booking system — Supabase PostgreSQL schema.
// The database URL is configured in prisma.config.ts (Prisma 7).
//
// Conventions
// - Table and column names match the Laravel database 1:1 (via @@map / @map) so CSV
//   exports import without renaming. Prisma models and fields use TypeScript naming.
// - Ids are `Int` (PostgreSQL integer, sequence-backed). Largest existing id is < 2,000;
//   integer avoids BigInt serialisation problems in JSON. Imported ids are preserved and
//   sequences are reset after import (see post-migration.sql).
// - Timestamps are timestamptz (UTC). Flight date/time and dates of birth are plain
//   date/time values (local Pakistan wall-clock), exactly as stored today.
// - Money stays in its current type: whole-rupee integers where Laravel used int,
//   numeric(15,2) where Laravel used decimal.
// - `deleted_at` soft deletes are preserved.
// - Constraints Prisma cannot express (CHECKs, case-insensitive email uniqueness, RLS)
//   are in post-migration.sql.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Identity & access ───────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  firstName       String?   @map("name") @db.VarChar(255)
  lastName        String?   @map("lname") @db.VarChar(50)
  cnic            String?   @db.VarChar(50)
  contact         String?   @db.VarChar(50)
  // Uniqueness is case-insensitive (matches MariaDB collation): see post-migration.sql.
  email           String    @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  // Laravel bcrypt ($2y$) hashes are verified as-is by the bcrypt library.
  password        String    @db.VarChar(255)
  // OTP is stored hashed (Laravel stored it in plain text; plain values are not imported).
  otpHash         String?   @map("otp_hash") @db.VarChar(255)
  otpExpiresAt    DateTime? @map("otp_expires_at") @db.Timestamptz(6)
  otpAttempts     Int       @default(0) @map("otp_attempts")
  rememberToken   String?   @map("remember_token") @db.VarChar(255)
  /// Google account id ("sub" claim) once the user has signed in with Google.
  googleSub       String?   @unique @map("google_sub") @db.VarChar(255)
  /// Profile picture URL from Google, when the user signed in with Google.
  avatarUrl       String?   @map("avatar_url") @db.VarChar(1024)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles               RoleUser[]
  bookings            Booking[]
  checkedInBookings   Booking[]            @relation("BookingCheckedInBy")
  payments            Payment[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Role {
  id        Int       @id @default(autoincrement())
  title     String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  users       RoleUser[]
  permissions PermissionRole[]

  @@map("roles")
}

model Permission {
  id        Int       @id @default(autoincrement())
  title     String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles PermissionRole[]

  @@map("permissions")
}

model RoleUser {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("role_user")
}

model PermissionRole {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("permission_role")
}

// New: replaces Sanctum personal_access_tokens. Only a hash of the token is stored.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// New: single-use token proving the user verified an OTP or clicked a reset link.
// Required by the password reset endpoints (fixes the unauthenticated reset).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────── Catalog ─────────────────────────────────────

// Laravel table `lounge_services`. Ids 1–4 are referenced by business logic
// (1 Meet & Assist, 2 Lounge, 3 Membership, 4 Premier) — keep them stable.
model Service {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  iconForApp String?   @map("icon_for_app") @db.VarChar(20)
  appDesc    String?   @map("app_desc") @db.VarChar(100)
  appRoute   String?   @map("app_route") @db.VarChar(45)
  appIcon    String?   @map("app_icon") @db.VarChar(45)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]
  bookings Booking[]

  @@map("lounge_services")
}

// Ids 1 Domestic, 2 International, 3 International-domestic are used by business logic.
model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String?   @db.VarChar(255)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  products Product[]
  bookings Booking[]

  @@map("product_categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  serviceId   Int       @map("service_id")
  categoryId  Int       @map("category_id")
  name        String?   @db.VarChar(255)
  description String?
  // Adult price. decimal in the source; other prices are whole-rupee integers.
  price       Decimal?  @db.Decimal(15, 2)
  adultLimit  Int       @map("adult_limit")
  childPrice  Int       @map("child_price")
  childLimit  Int       @map("child_limit")
  infantPrice Int       @map("infant_price")
  infantLimit Int       @map("infant_limit")
  guestPrice  Int?      @map("guest_price")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  service     Service         @relation(fields: [serviceId], references: [id])
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  bookings    Booking[]
  memberships Membership[]

  @@index([serviceId, categoryId])
  @@map("products")
}

// Bank cards eligible for lounge access. Referenced by bookings.bank_id.
// services_code and visit_type intentionally dropped (unused, approved for removal).
model Card {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(200)
  detail    String    @db.VarChar(50)
  bin       String    @db.VarChar(100)
  sortOrder Int?      @map("sort_order") @db.SmallInt
  isActive  Boolean   @default(true) @map("status")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  bookings Booking[]

  @@map("cards")
}

model MembershipType {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  price1     Decimal   @map("price_1") @db.Decimal(15, 2)
  price1Text String    @map("price_1_text") @db.VarChar(100)
  price2     Decimal   @map("price_2") @db.Decimal(15, 2)
  price2Text String    @map("price_2_text") @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships Membership[]

  @@map("membership_types")
}

// ───────────────────────────────── Memberships ───────────────────────────────────

// status: 1 = pending application, 2 = approved (CHECK in post-migration.sql).
// product_id and visit_limit are nullable: they are assigned on approval. In Laravel
// they were NOT NULL, which made the public application form fail under strict mode.
model Membership {
  id                    Int       @id @default(autoincrement())
  membershipTypeId      Int?      @map("membership_type_id")
  productId             Int?      @map("product_id")
  serialNo              String    @default("0") @map("serial_no") @db.VarChar(200)
  visitLimit            Int?      @map("visit_limit")
  name                  String    @db.VarChar(255)
  dob                   DateTime  @db.Date
  contactNo             String    @map("contact_no") @db.VarChar(255)
  email                 String    @db.VarChar(255)
  address               String?
  city                  String    @db.VarChar(100)
  state                 String    @db.VarChar(100)
  zipcode               String    @db.VarChar(100)
  country               String    @db.VarChar(100)
  membershipDeclaration String?   @default("0") @map("membership_declaration") @db.VarChar(2)
  status                Int       @default(1) @db.SmallInt
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  membershipType MembershipType? @relation(fields: [membershipTypeId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  bookings       Booking[]

  @@index([serialNo])
  @@index([status])
  @@map("memberships")
}

// ─────────────────────────────────── Bookings ────────────────────────────────────

// code format: "ML" + id zero-padded to 7 digits. The id is reserved from the sequence
// inside the booking transaction, so code and id always agree and cannot collide.
model Booking {
  id              Int       @id @default(autoincrement())
  serviceId       Int       @map("service_id")
  customerId      Int?      @map("customer_id")
  categoryId      Int?      @map("category_id")
  productId       Int?      @map("product_id")
  sourceRequestId Int?      @map("source_request_id")
  membershipId    Int?      @map("membership_id")
  bankCardId      Int?      @map("bank_id")
  code            String    @unique @db.VarChar(255)
  flightNumber    String    @map("flight_number") @db.VarChar(255)
  flightDetail    String?   @map("flight_detail") @db.VarChar(255)
  departureDate   DateTime  @map("departure_date") @db.Date
  departureTime   DateTime? @map("departure_time") @db.Time(0)
  adultQty        Int?      @map("adult_qty")
  childQty        Int?      @map("child_qty")
  infantQty       Int?      @map("infant_qty")
  guestQty        Int?      @map("guest_qty")
  // Whole PKR. Computed server-side for new bookings.
  totalAmount     Int?      @map("total_amount")
  // New: client-supplied key that makes POST /bookings safe to retry.
  idempotencyKey  String?   @map("idempotency_key") @db.VarChar(100)
  /// not_required | pending | paid | failed | refunded (CHECK constraint in migration).
  /// Bookings with a total of 0 (bank-card lounge access, membership visits) never need payment.
  paymentStatus   String    @default("not_required") @map("payment_status") @db.VarChar(20)
  /// Unguessable token in the customer's QR pass. Generated by the database for every booking.
  passToken       String    @unique @default(dbgenerated("(replace((gen_random_uuid())::text, '-'::text, ''::text) || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @map("pass_token") @db.VarChar(64)
  /// When staff accepted the pass at the counter (a pass can be used once).
  checkedInAt     DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedInById   Int?      @map("checked_in_by")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  service       Service           @relation(fields: [serviceId], references: [id])
  customer      User?             @relation(fields: [customerId], references: [id])
  checkedInBy   User?             @relation("BookingCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  category      ProductCategory?  @relation(fields: [categoryId], references: [id])
  product       Product?          @relation(fields: [productId], references: [id])
  sourceRequest SourceRequest?    @relation(fields: [sourceRequestId], references: [id])
  membership    Membership?       @relation(fields: [membershipId], references: [id])
  bankCard      Card?             @relation(fields: [bankCardId], references: [id])
  attendees     BookingAttendee[]
  payments      Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId])
  @@index([membershipId])
  @@index([departureDate])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("bookings")
}

// Laravel table `booking_details`. attendee_type: 1 Adult, 2 Child, 3 Infant.
model BookingAttendee {
  id                 Int       @id @default(autoincrement())
  bookingId          Int       @map("booking_id")
  // Free text in the source data (not a FK to nationalities).
  nationality        String?   @db.VarChar(100)
  attendeeType       Int       @map("attendee_type") @db.SmallInt
  name               String    @db.VarChar(255)
  dob                DateTime  @db.Date
  passportCnic       String?   @map("passport_cnic") @db.VarChar(255)
  passportCnicExpiry String?   @map("passport_cnic_expiry") @db.VarChar(255)
  contactNo          String?   @map("contact_no") @db.VarChar(100)
  email              String?   @db.VarChar(255)
  address            String?
  // New: collected by the form since launch but never stored by Laravel.
  guardianContact    String?   @map("guardian_contact") @db.VarChar(100)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_details")
}

/// One payment attempt for a booking through a payment gateway (Safepay).
/// A booking can have several attempts (e.g. a failed card, then a successful one);
/// at most one is "pending" at a time, and the booking's payment_status mirrors the latest outcome.
model Payment {
  id               Int       @id @default(autoincrement())
  bookingId        Int       @map("booking_id")
  customerId       Int?      @map("customer_id")
  /// "safepay"
  gateway          String    @db.VarChar(30)
  /// Safepay tracker token (track_…): the gateway's id for this payment session.
  gatewayReference String    @unique @map("gateway_reference") @db.VarChar(100)
  /// Amount in the smallest currency unit, exactly as sent to the gateway (PKR → paisa).
  amountMinor      Int       @map("amount_minor")
  currency         String    @db.Char(3)
  /// pending | paid | failed | cancelled | refunded (CHECK constraint in migration).
  status           String    @db.VarChar(20)
  /// Last state reported by the gateway, e.g. TRACKER_ENDED.
  gatewayState     String?   @map("gateway_state") @db.VarChar(40)
  /// Card brand and last four digits, when the gateway reports them.
  paymentMethod    String?   @map("payment_method") @db.VarChar(60)
  /// Last gateway response or webhook payload, for support and reconciliation (no card data).
  gatewayResponse  Json?     @map("gateway_response")
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id])
  customer User?   @relation(fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

// Bookings received via the mobile app's WhatsApp flow. The table did not exist in
// production yet; columns follow the Laravel model and controller validation.
model WhatsappBooking {
  id            Int       @id @default(autoincrement())
  service       String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(15, 2)
  departureDate DateTime  @map("departure_date") @db.Date
  departureTime DateTime  @map("departure_time") @db.Time(0)
  adultQty      Int       @map("adult_qty")
  childQty      Int       @map("child_qty")
  infantQty     Int       @map("infant_qty")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("whatsapp_booking")
}

// ─────────────────────────────────── Lookups ─────────────────────────────────────

// Ids 1 Web, 2 App are used by business logic.
model SourceRequest {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  bookings Booking[]

  @@map("source_requests")
}

model Nationality {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("nationalities")
}

// Admin-managed lookup. Not linked to bookings in the current system.
model Status {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("statuses")
}

// ─────────────────────────────────── Content ─────────────────────────────────────

model FaqCategory {
  id        Int       @id @default(autoincrement())
  category  String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions FaqQuestion[]

  @@map("faq_categories")
}

model FaqQuestion {
  id         Int       @id @default(autoincrement())
  categoryId Int?      @map("category_id")
  question   String?
  answer     String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  category FaqCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("faq_questions")
}

// ──────────────────────────────────── Audit ──────────────────────────────────────

// subject_type keeps the Laravel format ("App\Models\Booking#12") for imported rows;
// new rows use the Prisma model name in the same "<Model>#<id>" format.
model AuditLog {
  id          Int       @id @default(autoincrement())
  description String
  subjectId   Int?      @map("subject_id")
  subjectType String?   @map("subject_type") @db.VarChar(255)
  userId      Int?      @map("user_id")
  properties  Json?
  host        String?   @db.VarChar(46)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subjectType])
  @@index([createdAt])
  @@map("audit_logs")
}
